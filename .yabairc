#!/usr/bin/env sh

#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#

sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

source $HOME/.config/functions/create_spaces.sh

# Prevent creation of extra spaces beyond 8
yabai -m signal --add event=space_created action="if \$(yabai -m query --spaces | jq -r \"map(select(.index)) | last > 8\"); then yabai -m space --destroy \$(yabai -m query --spaces | jq -r .[-1].index); fi"

# bsp, stack, float
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config window_shadow off

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move

yabai -m config top_padding 0
yabai -m config bottom_padding 20
yabai -m config left_padding 20
yabai -m config right_padding 20
yabai -m config window_gap 20
yabai -m config external_bar all:75:0

# Window Rules - Apps that should not be tiled
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Nextcloud$" manage=off
yabai -m rule --add app="^ColorSlurp$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^JetBrains Toolbox$" manage=off
yabai -m rule --add app="^Home Assistant$" manage=off
yabai -m rule --add app="^zoom.us$" manage=off
yabai -m rule --add app="^zoom$" manage=off
yabai -m rule --add app="^Alfred 5$" manage=off
yabai -m rule --add app="^Alfred Preferences$" manage=off
yabai -m rule --add app="^iStats Menus$" manage=off
yabai -m rule --add app="^balenaEtcher$" manage=off
yabai -m rule --add app="^TV$" manage=off
yabai -m rule --add app="^Home$" manage=off
yabai -m rule --add app="^Messages$" manage=off
yabai -m rule --add app="^Keychain Access$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^SF Symbols$" manage=off
yabai -m rule --add app="^NotchNook$" manage=off
yabai -m rule --add app="^Bartender$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^VLC$" manage=off
yabai -m rule --add app="^BetterDisplay$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Setapp$" manage=off
yabai -m rule --add app="^Ice$" manage=off
yabai -m rule --add app="^PDFgear$" manage=off
yabai -m rule --add app="^Fusion$" manage=off
yabai -m rule --add app="^Autodesk Fusion$" manage=off
yabai -m rule --add app="^Fusion$" subrole="^AXSystemDialog$" manage=off
yabai -m rule --add app="^Fusion$" subrole="^AXDialog$" manage=off
yabai -m rule --add app="^Arc$" subrole="^AXSystemDialog$" manage=off
yabai -m rule --add app="^Dia$" subrole="^AXSystemDialog$" manage=off
yabai -m rule --add app="^Zen$" subrole="^AXSystemDialog$" manage=off
yabai -m rule --add app="^Bambu Studio$" subrole="^AXDialog$" manage=off
yabai -m rule --add app="^Claude$" manage=off
yabai -m rule --add app="^Logitech G HUB$" manage=off
#yabai -m rule --add app="^Stats$" manage=off
yabai -m rule --add app="^TinkerTool$" manage=off
yabai -m rule --add app="^Bitwarden$" manage=off
yabai -m rule --add app="^Logi Options+$" manage=off
yabai -m rule --add app="^EQ Mac$" manage=off
yabai -m rule --add app="Stats" manage=on sticky=off layer=normal
yabai -m rule --add title=".*Bitwarden.*" manage=off
# Space Assignment Rules
# Display 1 (Horizontal) - Spaces 1-4
# Space 1 - A: Browsers
yabai -m rule --add app="^Arc$" space=2
yabai -m rule --add app="^Dia$" space=2
yabai -m rule --add app="^Zen Browser$" space=2
yabai -m rule --add app="^Zen$" space=2
yabai -m rule --add app="^Google Chrome$" space=2
yabai -m rule --add app="^Chrome$" space=2

# Space 2 - F: Fusion 360
yabai -m rule --add app="^Autodesk Fusion$" space=4
yabai -m rule --add app="^Fusion 360$" space=4

# Space 3 - B: 3D Printing Apps
yabai -m rule --add app="^Bambu Studio$" space=3
yabai -m rule --add app="^BambuStudio$" space=3
yabai -m rule --add app="^OrcaSlicer$" space=3
yabai -m rule --add app="^PrusaSlicer$" space=3
yabai -m rule --add app="^Cura$" space=3

# Space 4 - W: Utilities/Config Apps
yabai -m rule --add app="^Wootility$" space=4
yabai -m rule --add app="^Zed$" space=4
yabai -m rule --add app="^wootility-lekker$" space=4
yabai -m rule --add app="^TickTick$" space=4
yabai -m rule --add app="^PDFgear$" space=4
yabai -m rule --add app="^Ice$" space=4
yabai -m rule --add app="^iStats Menus$" space=4
yabai -m rule --add app="^Stats$" space=4
yabai -m rule --add app="^TinkerTool$" space=4

# Display 2 (Vertical) - Spaces 5-8
# Space 5 - D: Discord
yabai -m rule --add app="^Legcord$" space=5
yabai -m rule --add app="^Discord$" space=5

# Space 6 - X: Terminal
yabai -m rule --add app="^iTerm2$" space=1
yabai -m rule --add app="^iTerm$" space=1
yabai -m rule --add app="^Alacritty$" space=1
yabai -m rule --add app="^WezTerm$" space=1
yabai -m rule --add app="^Ghostty$" space=1
yabai -m rule --add app="^Fleet$" space=1
yabai -m rule --add app="^Ghostty$" space=1
yabai -m rule --add app="^kitty$" space=1


# Space 7 - O: Obsidian
yabai -m rule --add app="^Obsidian$" space=7

# Space 8 - S: Music/Audio
yabai -m rule --add app="^Spotify$" space=8
yabai -m rule --add app="^Music$" space=8
yabai -m rule --add app="^eqMac$" space=8

# Signals
yabai -m signal --add event=window_destroyed active=yes action="yabai -m query --windows --window &> /dev/null || yabai -m window --focus mouse &> /dev/null || yabai -m window --focus \$(yabai -m query --windows --space | jq .[0].id) &> /dev/null"
yabai -m signal --add event=window_minimized active=yes action="if \$(yabai -m query --windows --window \$YABAI_WINDOW_ID | jq -r '.\"is-floating\"'); then yabai -m query --windows --window &> /dev/null || yabai -m window --focus mouse &> /dev/null || yabai -m window --focus \$(yabai -m query --windows --space | jq .[0].id) &> /dev/null; fi"

# Position Stats popups below Sketchybar using AppleScript
yabai -m signal --add event=window_created app="^Stats$" action='osascript -e "tell application \"System Events\" to tell process \"Stats\" to set position of window 1 to {item 1 of (get position of window 1), (item 2 of (get position of window 1)) + 60}"'

# Center all floating windows when created (with ignore list)
yabai -m signal --add event=window_created action='
is_floating=$(yabai -m query --windows --window $YABAI_WINDOW_ID | jq -r ".\"is-floating\"")
if [ "$is_floating" = "true" ]; then
    app_name=$(yabai -m query --windows --window $YABAI_WINDOW_ID | jq -r ".app")
    window_title=$(yabai -m query --windows --window $YABAI_WINDOW_ID | jq -r ".title")

    # List of apps/windows to ignore for auto-positioning
    ignore_apps=("Fusion" "Stats" "Claude" "Bitwarden" "Logi Options+" "EQ Mac" "Nextcloud")
    ignore_titles=("Bitwarden")

    # Check if app should be ignored
    should_ignore=false
    for ignore_app in "${ignore_apps[@]}"; do
        if [ "$app_name" = "$ignore_app" ]; then
            should_ignore=true
            break
        fi
    done

    # Check if window title should be ignored
    if [ "$should_ignore" = false ]; then
        for ignore_title in "${ignore_titles[@]}"; do
            if [[ "$window_title" == *"$ignore_title"* ]]; then
                should_ignore=true
                break
            fi
        done
    fi

    # Center floating window if not in ignore list
    if [ "$should_ignore" = false ]; then
        yabai -m window $YABAI_WINDOW_ID --grid 6:5:2:0:1:5
    fi
fi
'



yabai -m rule --apply
echo "Yabai configuration loaded..."
