[manager]
# Layout: 1 parent column, 1 current column, 1 preview column
ratio = [0, 1, 1]

# Show hidden files
show_hidden = true

# Sort settings
sort_by = "natural"
sort_sensitive = false
sort_reverse = false
sort_dir_first = true

# Line mode shows file info
linemode = "size"

# Show symlink targets
show_symlink = true

[preview]
# Image preview settings
max_width = 1000
max_height = 1000

# Use sixel for image preview (Kitty uses its own protocol automatically)
image_quality = 90

# Cache for thumbnails
cache_dir = ""

[opener]
# Default openers
edit = [
  { run = 'nvim "$@"', block = true, for = "unix" },
]
open = [
  { run = 'open "$@"', for = "macos" },
]

[open]
rules = [
  { mime = "text/*", use = "edit" },
  { mime = "image/*", use = "open" },
  { mime = "video/*", use = "open" },
  { mime = "audio/*", use = "open" },
  { mime = "application/json", use = "edit" },
  { mime = "application/pdf", use = "open" },
  { mime = "*", use = "open" },
]
