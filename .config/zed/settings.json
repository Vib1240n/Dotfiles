{
  "edit_predictions": {
    "mode": "subtle"
  },
  "agent": {
    "always_allow_tool_actions": true,
    "model_parameters": []
  },
  "icon_theme": "Monospace Icon Theme - Dark",
  "disable_ai": true,
  "terminal": {
    "dock": "right"
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_gitignore": true,
    "hide_root": false,
    "indent_size": 18.0,
    "entry_spacing": "standard",
    "dock": "right",
    "default_width": 245.0
  },
  "theme": "Obsidian Sunset custom",
  "buffer_font_family": "CommitMono Nerd Font Mono",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 18,
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "gutter": {
    "breakpoints": false,
    "runnables": false,
    "folds": false
  },
  "ssh_connections": [
    {
      "host": "192.168.6.38",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": [
            "/./"
          ]
        },
        {
          "paths": [
            "/config"
          ]
        },
        {
          "paths": [
            "/config/./"
          ]
        },
        {
          "paths": [
            "/root"
          ]
        }
      ]
    }
  ],
  "tab_bar": {
    "show": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "soft_wrap": "preferred_line_length",
  "preferred_line_length": 80,
  "show_wrap_guides": true,
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": [
        "pyright",
        "ruff"
      ],
      "tab_size": 4,
      "hard_tabs": false,
      "auto_indent": true,
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": [
            "format",
            "--line-length",
            "88",
            "-"
          ]
        }
      },
      "format_on_save": "on"
    },
    "Shell Script": {
      "show_completions_on_input": true,
      "language_servers": [
        "bash-language-server"
      ],
      "tab_size": 2
    }
  },
  "lsp": {
    "pyright": {
      "initialization_options": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace"
          }
        }
      }
    },
    "bash-language-server": {
      "initialization_options": {
        "includeAllWorkspaceSymbols": true,
        "globPattern": "**/*@(.sh|.inc|.bash|.command)"
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 88,
          "lint": {
            "select": [
              "E",
              "F",
              "I"
            ],
            "fixAll": true
          },
          "format": {
            "indentStyle": "space"
          }
        }
      }
    }
  },
  "show_completions_on_input": true
}
