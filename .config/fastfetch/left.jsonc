// left.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ------>",
    "constants": [
      "─────────────────" // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 64
    }
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "┌{$2} {#1}Hardware Information{#} {$2}┐"
    },
    "break",
    "host",
    "cpu",
    "gpu",
    "disk",
    "memory",
    "swap",
    "display",
    "brightness",
    "battery",
    "poweradapter",
    "bluetooth",
    "sound",
    "gamepad",
    "break",
    "break",
    {
      "type": "custom", // InformationEnd
      "format": "└{$2}──────────────────────{$2}┘"
    }
  ]
}
