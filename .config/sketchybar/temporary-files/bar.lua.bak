local colors = require("colors")

local LIST_MODE = "aerospace list-modes --current"

local alpha_value = 1

-- sketchybar --add item left_anchor left --set left_anchor width=0 \
--            --add item q_anchor q --set q_anchor width=0 \
--            --add item e_anchor e --set e_anchor width=0 \
--            --add item right_anchor right --set right_anchor width=0 \
--            --add bracket left_bar left_anchor q_anchor \
--            --set left_bar background.color=0xff000000 \
--            --add bracket right_bar e_anchor right_anchor \
--            --set right_bar background.color=0xffffffff
-- Equivalent to the --bar domain
local default_bar = sbar.bar({
	height = 55,
	margin = 9,
	y_offset = 5,
	blur_radius = 20,
	corner_radius = 12,
	color = colors.bar,
	padding_right = 5,
	padding_left = 0,
	border_color = colors.border,
	border_width = 1,
	topmost = "off",
	sticky = "on",
	position = "top",
	notch_width = 300,
	display = "all",
	shadow = true,
})

default_bar.subscribe("mode_changed", function()
	sbar.exec(LIST_MODE, function(modeOutput)
		if modeOutput then
			modeOutput = modeOutput:gsub("%s+$", "") -- trim trailing spaces/newlines
			modeOutput = modeOutput:lower()
			if string.find(modeOutput, "main") then
				default_bar:set({ border_color = colors.with_alpha(colors.icon, alpha_value) })
			elseif string.find(modeOutput, "resize") then
				default_bar:set({ border_color = colors.with_alpha(colors.purple, alpha_value) })
			elseif string.find(modeOutput, "service") then
				default_bar:set({ border_color = colors.with_alpha(colors.orange, alpha_value) })
			elseif string.find(modeOutput, "open") then
				default_bar:set({ border_color = colors.with_alpha(colors.red, alpha_value) })
			elseif string.find(modeOutput, "pass") then
				default_bar:set({ border_color = colors.with_alpha(colors.green, alpha_value) })
			else
				default_bar:set({ border_color = colors.with_alpha(colors.magenta, alpha_value) })
			end
		end
	end)
end)
