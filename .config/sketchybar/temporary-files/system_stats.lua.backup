local colors = require("colors")
local settings = require("settings")

sbar.add("event", "fan_speed")

-- Bar mode toggle
local bar_toggle = sbar.add("item", "bar_toggle", {
	position = "right",
	icon = {
		string = "􀨤",
		font = { family = settings.font.text, style = settings.font.style_map["Regular"], size = settings.fontL },
		color = colors.icon,
		padding_left = 6,
	},
	label = { drawing = false },
	background = { drawing = false },
})

bar_toggle:subscribe("mouse.entered", function()
	bar_toggle:set({ icon = { color = colors.white } })
end)
bar_toggle:subscribe("mouse.exited", function()
	bar_toggle:set({ icon = { color = colors.icon } })
end)
bar_toggle:subscribe("mouse.clicked", function()
	sbar.trigger("bar_toggle_clicked")
end)

-- Helper: get battery icon based on percentage and charging state
local function get_battery_icon(percent, charging)
	if charging then
		if percent >= 75 then
			return "􀢋"
		elseif percent >= 50 then
			return "􀢌"
		elseif percent >= 25 then
			return "􀢍"
		else
			return "􀢎"
		end
	else
		if percent >= 75 then
			return "􀛨"
		elseif percent >= 50 then
			return "􀺶"
		elseif percent >= 25 then
			return "􀺸"
		else
			return "􀛪"
		end
	end
end

-- BATTERY
local battery = sbar.add("item", "battery", {
	position = "right",
	update_freq = 60,
	icon = { string = "􀛨", font = { size = settings.fontXL }, color = colors.icon, padding_right = 4 },
	label = { string = "100%", font = { size = settings.fontXL }, color = colors.white },
	popup = {
		align = "right",
		height = 30,
		y_offset = 5,
		background = { color = colors.bar_solid, corner_radius = 8, border_width = 1, border_color = colors.border },
	},
})

local battery_popup = sbar.add("item", "battery.popup", {
	position = "popup." .. battery.name,
	icon = { drawing = false },
	label = { font = { size = settings.fontXL }, color = colors.white, padding_left = 12, padding_right = 12 },
})

battery:subscribe({ "routine", "forced", "system_woke" }, function()
	sbar.exec("pmset -g batt", function(output)
		local percent = tonumber(output:match("(%d+)%%")) or 0
		local charging = output:match("AC Power") ~= nil or output:match("; charging;") ~= nil
		local time_str = output:match("(%d+:%d+) remaining") or ""
		local watts = output:match("%(.*?(%d+%.?%d*) watts%)") or ""
		battery:set({
			icon = { string = get_battery_icon(percent, charging), color = percent <= 20 and colors.red or colors.icon },
			label = { string = percent .. "%" },
		})
		local popup_text = charging and ("Charging: " .. time_str .. (watts ~= "" and " @ " .. watts .. "W" or ""))
				or ("Time remaining: " .. (time_str ~= "" and time_str or "Calculating..."))
		battery_popup:set({ label = popup_text })
	end)
end)
battery:subscribe("mouse.entered", function()
	sbar.animate("tanh", 15, function()
		battery:set({ popup = { drawing = true } })
	end)
end)
battery:subscribe("mouse.exited", function()
	sbar.animate("tanh", 15, function()
		battery:set({ popup = { drawing = false } })
	end)
end)

-- FAN (only shows when > 2500 RPM)
local fan = sbar.add("item", "fan", {
	position = "right",
	update_freq = 1,
	icon = { string = "􀇥", font = { size = settings.fontL }, color = colors.orange, padding_right = 4 },
	label = { string = "0", font = { size = settings.fontL }, color = colors.white, padding_right = 6 },
	drawing = false, -- Hidden by default
})

