-- Toggle function
local function toggle_stats()
	is_expanded = not is_expanded
	if is_expanded then
		stats_toggle:set({ icon = { string = "􀆊" } })
		sbar.animate("tanh", 20, function()
			cpu:set({ width = "dynamic", drawing = true })
			gpu:set({ width = "dynamic", drawing = true })
			ram:set({ width = "dynamic", drawing = true })
			network:set({ width = "dynamic", drawing = true })
			disk:set({ width = "dynamic", drawing = true })
		end)
	else
		stats_toggle:set({ icon = { string = "􀆉" } })
		sbar.animate("tanh", 20, function()
			cpu:set({ width = 0, drawing = false })
			gpu:set({ width = 0, drawing = false })
			ram:set({ width = 0, drawing = false })
			network:set({ width = 0, drawing = false })
			disk:set({ width = 0, drawing = false })
		end)
	end
end

stats_toggle:subscribe("mouse.clicked", toggle_stats)
stats_toggle:subscribe("mouse.entered", function()
	stats_toggle:set({ icon = { color = colors.white } })
end)
stats_toggle:subscribe("mouse.exited", function()
	stats_toggle:set({ icon = { color = colors.icon } })
end)

return { bar_toggle = bar_toggle, battery = battery }
