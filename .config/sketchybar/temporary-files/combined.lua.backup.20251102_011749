-- Update battery icon based on percentage
statsBattery:subscribe({ "routine", "power_source_change", "system_woke" }, function()
	sbar.exec("pmset -g batt", function(batt_info)
		local icon = "􀛨"  -- Default 100%
		local found, _, charge = batt_info:find("(%d+)%%")

		if found then
			charge = tonumber(charge)
			icon = (charge > 75 and "􀛨")
				or (charge > 50 and "􀺸")
				or (charge > 25 and "􀺶")
				or (charge > 10 and "􀛩")
				or "􀛪"

			-- Check if charging
			if batt_info:find("AC Power") then
				icon = "􀢋"  -- Charging icon
			end
		end

		statsBattery:set({ icon = { string = icon } })
	end)
end)

