-- Example: Menu Bar Extras Integration for SketchyBar
-- Uses PID-based approach for reliable menu bar extra clicking

local colors = require("colors")
local settings = require("settings")

-- Helper function to get PID of a process
local function get_pid(process_name)
    local handle = io.popen("pidof '" .. process_name .. "' 2>/dev/null")
    if not handle then return nil end
    
    local result = handle:read("*a")
    handle:close()
    
    if result and result ~= "" then
        return result:gsub("%s+", "")
    end
    return nil
end

-- Helper to create clickable menu bar extra items
local function create_menu_extra(name, process_name, index, icon, label)
    local pid = get_pid(process_name)
    
    if not pid then
        print("Warning: Process '" .. process_name .. "' not found, skipping " .. name)
        return nil
    end
    
    return sbar.add("item", "menu_extra." .. name, {
        position = "right",
        padding_left = settings.paddings,
        padding_right = settings.paddings,
        icon = {
            string = icon,
            color = colors.white,
            font = {
                style = settings.font.style_map["Bold"],
                size = 14.0,
            },
        },
        label = label and {
            string = label,
            color = colors.white,
            font = {
                style = settings.font.style_map["Semibold"],
                size = 12.0,
            },
        } or { drawing = false },
        background = {
            color = colors.bg1,
            corner_radius = 5,
            height = 24,
        },
        click_script = "$CONFIG_DIR/helpers/submenu/bin/submenu -c " .. pid .. " " .. (index or 0),
    })
end

