# Layout switching (matching aerospace)
# default < ctrl + alt + shift + cmd - slash : yabai -m space --layout bsp
# default < ctrl + alt + shift + cmd - comma : yabai -m space --layout stack

# Window focus (matching aerospace ctrl-alt-shift-cmd-hjkl)
default < ctrl + alt + shift + cmd - h : yabai -m window --focus west
default < ctrl + alt + shift + cmd - j : yabai -m window --focus south
default < ctrl + alt + shift + cmd - k : yabai -m window --focus north
default < ctrl + alt + shift + cmd - l : yabai -m window --focus east

# Window movement (matching aerospace alt-ctrl-shift-hjkl)
default < alt + ctrl + shift - h : yabai -m window --swap west
default < alt + ctrl + shift - j : yabai -m window --swap south
default < alt + ctrl + shift - k : yabai -m window --swap north
default < alt + ctrl + shift - l : yabai -m window --swap east

# Letter workspaces mapped to numbered spaces (matching aerospace but using hyper)
# hyper = ctrl + alt + shift + cmd
default < ctrl + alt + shift + cmd - a : yabai -m space --focus 1   # Arc Browser
default < ctrl + alt + shift + cmd - z : yabai -m space --focus 2   # Zen browser
default < ctrl + alt + shift + cmd - d : yabai -m space --focus 3   # Discord
default < ctrl + alt + shift + cmd - x : yabai -m space --focus 4   # Terminal/Xterm
default < ctrl + alt + shift + cmd - f : yabai -m space --focus 5   # Fusion 360
default < ctrl + alt + shift + cmd - b : yabai -m space --focus 6   # Bambu Studio
default < ctrl + alt + shift + cmd - w : yabai -m space --focus 7   # Wootility
default < ctrl + alt + shift + cmd - e : yabai -m space --focus 8   # Utility workspace
default < ctrl + alt + shift + cmd - c : yabai -m space --focus 9   # Chrome
default < ctrl + alt + shift + cmd - o : yabai -m space --focus 10  # Obsidian
default < ctrl + alt + shift + cmd - s : yabai -m space --focus 11  # Spotify/Music

# Move window to workspace and follow (alt-shift-ctrl)
default < alt + shift + ctrl - a : yabai -m window --space 1; yabai -m space --focus 1
default < alt + shift + ctrl - z : yabai -m window --space 2; yabai -m space --focus 2
default < alt + shift + ctrl - d : yabai -m window --space 3; yabai -m space --focus 3
default < alt + shift + ctrl - x : yabai -m window --space 4; yabai -m space --focus 4
default < alt + shift + ctrl - f : yabai -m window --space 5; yabai -m space --focus 5
default < alt + shift + ctrl - b : yabai -m window --space 6; yabai -m space --focus 6
default < alt + shift + ctrl - w : yabai -m window --space 7; yabai -m space --focus 7
default < alt + shift + ctrl - e : yabai -m window --space 8; yabai -m space --focus 8
default < alt + shift + ctrl - c : yabai -m window --space 9; yabai -m space --focus 9
default < alt + shift + ctrl - o : yabai -m window --space 10; yabai -m space --focus 10
default < alt + shift + ctrl - s : yabai -m window --space 11; yabai -m space --focus 11

# Workspace back and forth (matching aerospace alt-tab)
# default < alt - tab : yabai -m space --focus recent

# Display/Monitor focus (matching aerospace)
default < ctrl + alt + shift - space : yabai -m display --focus prev
default < ctrl + alt + shift + cmd - space : yabai -m display --focus next
default < ctrl + alt + shift + cmd - 0x18 : yabai -m window --display 1; yabai -m display --focus 1
default < ctrl + alt + shift + cmd - 0x1B : yabai -m window --display 2; yabai -m display --focus 2

# Move workspace to next monitor (matching aerospace alt-shift-tab)
default < alt + shift - tab : yabai -m window --display next; yabai -m display --focus next

# Quick launcher (matching aerospace f20)
default < f20 : open -a /Applications/TickTick.app

# Finder launcher (matching aerospace alt-enter)
default < alt - return : open -a /System/Library/CoreServices/Finder.app
default < ctrl - return : open -a /Applications/iTerm.app
# Claude launcher (matching aerospace ctrl-shift-cmd-alt-enter)
default < ctrl + shift + cmd + alt - return : open -a /Applications/Claude.app

# Toggle window between monitors (hyper + space)
default < ctrl + alt + shift + cmd - 0x31 : $(yabai -m window --display next || yabai -m window --display first) && yabai -m display --focus next || yabai -m display --focus first

# Mode switching (matching aerospace keybindings)
# default < alt + shift + ctrl + cmd - semicolon ; service
default < alt + shift + ctrl + cmd - 0x29 ; service
default < alt + shift + ctrl + cmd - 0x1E ; resize       # right bracket ]
default < alt + shift + ctrl + cmd - 0x21 ; resize       # left bracket [
default < alt + shift + ctrl + cmd - i ; open
default < alt + shift + ctrl + cmd - p ; pass
default < alt - escape : sketchybar --trigger swap_menus_and_spaces
