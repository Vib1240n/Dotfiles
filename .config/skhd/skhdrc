# changing window focus
alt + shift - w : yabai -m window --focus north
alt + shift - s : yabai -m window --focus south
alt + shift - a : yabai -m window --focus west
alt + shift - d : yabai -m window --focus east

# controlling display focus
alt + shift + ctrl - a : yabai -m display --focus west
alt + shift + ctrl - d : yabai -m display --focus east
alt + shift + ctrl - w : yabai -m display --focus north
alt + shift + ctrl - s : yabai -m display --focus south

# # Rotate on X and Y Axis
alt + shift - x : yabai -m space --mirror x-axis
alt + shift - y : yabai -m space --mirror y-axis

# controlling window size and split
shift + alt - m : yabai -m window --toggle zoom-fullscreen
shift + alt + ctrl - space : yabai -m window --toggle split

# swapping
alt + shift - k : yabai -m window --swap north && yabai -m window --focus south
alt + shift - j : yabai -m window --swap south && yabai -m window --focus north
alt + shift - h : yabai -m window --swap west && yabai -m window --focus east
alt + shift - l : yabai -m window --swap east && yabai -m window --focus west

# Warping windows
ctrl + shift + alt - k : yabai -m window --warp north
ctrl + shift + alt - h : yabai -m window --warp west 
ctrl + shift + alt - l : yabai -m window --warp east
ctrl + shift + alt - j : yabai -m window --warp south 

# moving windows to different spaces
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1;
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2;
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3;
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4;
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5;
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6;
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7;
alt + shift - f : yabai -m space --create && yabai -m space --focus next
alt + shift - g : yabai -m space --destroy && yabai -m space --focus last

# starting and stopping yabai
ctrl + alt + cmd - i : yabai --start-service
ctrl + alt + cmd - o : yabai --stop-service
ctrl + alt + cmd - p : yabai --restart-service

# restarting skhd
ctrl + alt + cmd - j : skhd --start-service
ctrl + alt + cmd - k : skhd --stop-service
ctrl + alt + cmd - l : skhd --restart-service

# moving windows to different displays
alt + ctrl + shift - 1 : yabai -m window --display 1
alt + ctrl + shift - 2 : yabai -m window --display 2
alt + ctrl + shift - 3 : yabai -m window --display 3
alt + ctrl + shift - 4 : yabai -m window --display 4

#balance windows
ctrl + alt + cmd - b : yabai -m space --balance

# move focused window to different areas warp
alt + ctrl + shift - j : yabai -m window --warp north
alt + ctrl + shift - k : yabai -m window --warp south
alt + ctrl + shift - l : yabai -m window --warp east
alt + ctrl + shift - h : yabai -m window --warp west
# Rotate on X and Y Axis

# Rotatiing windoes on Display
shift + alt - t : yabai -m window --toggle float
shift + alt - r : yabai -m space --rotate 90

# Moving to space index
alt - 1 : yabai -m space focus 1
alt - 2 : yabai -m space focus 2
alt - 3 : yabai -m space focus 3
alt - 4 : yabai -m space focus 4 
alt - 5 : yabai -m space focus 5 
alt - 6 : yabai -m space focus 6
alt - 7 : yabai -m space focus 7
alt - 8 : yabai -m space focus 8

# Creating and Destroying spaces
alt + shift - f : yabai -m space --create
alt + shift - g : yabai -m space --destroy



