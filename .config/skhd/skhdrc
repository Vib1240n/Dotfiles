# Mode definitions with borders
:: default : sketchybar --trigger mode_change MODE=default
:: resize  : sketchybar --trigger mode_change MODE=resize
:: service : sketchybar --trigger mode_change MODE=service
:: open    : sketchybar --trigger mode_change MODE=open
:: pass    : sketchybar --trigger mode_change MODE=pass

