# Resize mode bindings (matching aerospace)
# resize < 0x18 : yabai -m window --resize right:50:0        # equal key (+) - increase width
# resize < 0x1B : yabai -m window --resize right:-50:0       # minus key (-) - decrease width
resize < f : yabai -m window --toggle zoom-fullscreen; skhd -k "escape"
# resize < j : yabai -m window --resize bottom:0:50          # increase height
# resize < k : yabai -m window --resize bottom:0:-50         # decrease height
resize < escape; default
resize < b : yabai -m space --balance; skhd -k "escape"
resize < return; default
resize < h : yabai -m window --resize left:-50:0
resize < j : yabai -m window --resize bottom:0:50
resize < k : yabai -m window --resize bottom:0:-50
resize < l : yabai -m window --resize left:50:0
resize < s : yabai -m window --toggle split && yabai -m space --balance; default
# Join/warp windows (using hyper alias in resize mode)
resize < hyper - h : yabai -m window --warp west;
resize < hyper - j : yabai -m window --warp south;
resize < hyper - k : yabai -m window --warp north;
resize < hyper - l : yabai -m window --warp east;

# Additional resize mode commands
# resize < backspace : yabai -m window --close; skhd -k "escape"
resize < r : yabai -m space --rotate 90; skhd -k "escape"
resize < meh - f : yabai -m window --toggle float; skhd -k "escape"

# Floating window positioning hotkeys
resize < shift + alt - h : yabai -m window --grid 1:2:0:0:1:1; skhd -k "escape"   # Left half
resize < shift + alt - l : yabai -m window --grid 1:2:1:0:1:1; skhd -k "escape"   # Right half


