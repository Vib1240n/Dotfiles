# Layout switching (matching aerospace)
# default < ctrl + alt + shift + cmd - slash : yabai -m space --layout bsp
# default < ctrl + alt + shift + cmd - comma : yabai -m space --layout stack

# Window focus (using hyper keyword as test)
default < hyper - h : yabai -m window --focus west
default < hyper - j : yabai -m window --focus south
default < hyper - k : yabai -m window --focus north
default < hyper - l : yabai -m window --focus east

# Window movement (using meh alias)
# meh = ctrl + shift + alt
default < meh - h : yabai -m window --swap west
default < meh - j : yabai -m window --swap south
default < meh - k : yabai -m window --swap north
default < meh - l : yabai -m window --swap east

# Letter workspaces mapped to numbered spaces (using hyper alias)
# hyper = ctrl + alt + shift + cmd
default < hyper - 1 : yabai -m space --focus 1   # Browsers (Arc, Zen, Chrome)
default < hyper - 2 : yabai -m space --focus 2   # Fusion 360
default < hyper - 3 : yabai -m space --focus 3   # 3D Printing (Bambu, etc)
default < hyper - 4 : yabai -m space --focus 4   # Utilities (Wootility, etc)
default < hyper - 5 : yabai -m space --focus 5   # Discord
default < hyper - 6 : yabai -m space --focus 6   # Terminal
default < hyper - 7 : yabai -m space --focus 7   # Obsidian
default < hyper - 8 : yabai -m space --focus 8   # Spotify/Music

# Move window to workspace and follow (using meh alias)
default < meh - 1 : yabai -m window --space 1; yabai -m space --focus 1
default < meh - 2 : yabai -m window --space 2; yabai -m space --focus 2
default < meh - 3 : yabai -m window --space 3; yabai -m space --focus 3
default < meh - 4 : yabai -m window --space 4; yabai -m space --focus 4
default < meh - 5 : yabai -m window --space 5; yabai -m space --focus 5
default < meh - 6 : yabai -m window --space 6; yabai -m space --focus 6
default < meh - 7 : yabai -m window --space 7; yabai -m space --focus 7
default < meh - 8 : yabai -m window --space 8; yabai -m space --focus 8
default < meh - a : yabai -m window --display 1; yabai -m display --focus 1
default < meh - d : yabai -m window --display 2; yabai -m display --focus 2

# Workspace back and forth (matching aerospace alt-tab)
# default < alt - tab : yabai -m space --focus recent

# Display/Monitor focus (cmd-tab style cycling)
default < hyper - space : yabai -m display --focus recent
default < meh - space : yabai -m space --focus recent
default < hyper - 0x18 : yabai -m window --display 1; yabai -m display --focus 1
default < hyper - 0x1B : yabai -m window --display 2; yabai -m display --focus 2

# Move workspace to next monitor (matching aerospace alt-shift-tab)
default < alt + shift - tab : yabai -m window --display next; yabai -m display --focus next

# Quick launcher (matching aerospace f20)
default < f20 : open -a /Applications/TickTick.app

# Finder launcher (matching aerospace alt-enter)
default < alt - return : open -a /System/Library/CoreServices/Finder.app
default < ctrl - return : open -a /Applications/iTerm.app
# Claude launcher (using hyper alias)
default < hyper - return : open -a /Applications/Claude.app

# Toggle window between monitors (hyper + space)
default < hyper - 0x31 : $(yabai -m window --display next || yabai -m window --display first) && yabai -m display --focus next || yabai -m display --focus first

# Mode switching (using hyper alias)
# default < hyper - semicolon ; service
default < hyper - 0x29 ; service
default < hyper - 0x1E ; resize       # right bracket ]
default < hyper - 0x21 ; resize       # left bracket [
default < hyper - r ; resize
# default < hyper - i ; open
default < hyper - p ; pass
default < alt - escape : sketchybar --trigger swap_menus_and_spaces
