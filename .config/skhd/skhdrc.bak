# changing window focus
# alt + shift - w : yabai -m window --focus north
# alt + shift - s : yabai -m window --focus south
# alt + shift - a : yabai -m window --focus west
# alt + shift - d : yabai -m window --focus east
# add an on_enter command to the default mode
cmd + shift - return : open -a /Applications/iTerm.app
:: resize : borders active_color=0xff23e9a4 inactive_color=0xff23e9a4 width=8.0 hidpi=on
:: default : borders active_color=0xffe2e2e3 inactive_color=0xff494d64 width=4.0 hidpi=on
:: service : borders active_color=0xffff710d inactive_color=0xffff710d width=8.0 hidpi=on style=round
:: launch : borders active_color=0xffe22c3c inactive_color=0xffe22c3c width=8.0 hidpi=on
:: pass : borders active_color=0xff9446f8 inactive_color=0xff9446f8 width=8.0 hidpi=on

# :: resize @ alt + shift - h : yabai -m window --resize left:20:0
# :: resize @ alt + shift - j : yabai -m window --resize left:20:-20
# :: resize @ alt + shift - k : yabai -m window --resize left:-20:20
#
# defines a new mode 'test' with an on_enter command, that captures keypresses
# :: test @ : yabai -m config active_window_border_color 0xff24ccaa
#
# from 'default' mode, activate mode 'resize'
# alt + shift - r ; resize
#
# from 'resize' mode, activate mode 'default'
# resize < alt + esc ; default
######
#Change modes
#Mode default
default < meh - r; resize
default < meh - s ; service
default < meh - return; launch
default < meh - backspace; pass

# Mode Resize
resize < hyper - d ; default
resize < hyper - s ; service
resize < hyper - return; launch
resize < escape ; default
resize < hyper - backspace; pass

#Mode Service
service < hyper - d ; default
service < hyper - r ; resize
service < hyper - return; launch
service < escape ; default
service < hyper  - backspace; pass

#Mode Launch
launch < hyper - d; default
launch < hyper - s; service
launch < hyper - r; resize
launch < hyper + shift - backspace; pass

pass < escape; default
pass < return; default





# controlling display focus
default < meh - a : yabai -m display --focus west
default < meh - d : yabai -m display --focus east
default < meh - w : yabai -m display --focus north
default < meh - s : yabai -m display --focus south

default < hyper - space : yabai -m display --focus next
default < meh - space : yabai -m display --focus prev

# # Rotate on X and Y Axis
default < hyper - x : yabai -m space --mirror x-axis
default < hyper - y : yabai -m space --mirror y-axis

# controlling window size and split

# swapping
default < alt + shift - k : yabai -m window --swap north && yabai -m window --focus north
default < alt + shift - j : yabai -m window --swap south && yabai -m window --focus south
default < alt + shift - h : yabai -m window --swap west && yabai -m window --focus west
default < alt + shift - l : yabai -m window --swap east && yabai -m window --focus east
# alt + shift : if [[ $(yabai -m query --spaces --display | jq '.[-1]."has-focus"') == "false" ]]; then yabai -m space --focus next; fi
# Warping windows
default < ctrl + shift + alt - k : yabai -m window --warp north
default < ctrl + shift + alt - h : yabai -m window --warp west 
default < ctrl + shift + alt - l : yabai -m window --warp east
default < ctrl + shift + alt - j : yabai -m window --warp south 

# moving windows to different spaces
default < meh - 1 : yabai -m window --space 1; yabai -m space --focus 1;
default < meh - 2 : yabai -m window --space 2; yabai -m space --focus 2;
default < meh - 3 : yabai -m window --space 3; yabai -m space --focus 3;
default < meh - 4 : yabai -m window --space 4; yabai -m space --focus 4;
default < meh - 5 : yabai -m window --space 5; yabai -m space --focus 5;
default < meh - 6 : yabai -m window --space 6; yabai -m space --focus 6;
default < meh - 7 : yabai -m window --space 7; yabai -m space --focus 7;
default < meh - f : yabai -m space --create && yabai -m space --focus next
default < meh - g : yabai -m space --destroy && yabai -m space --focus last

#moving windows to different displays
default < alt + shift - q : yabai -m window --display 1 
default < alt + shift - e : yabai -m window --display 2 
# starting and stopping yabai
service < alt + shift - 1 : yabai --start-service
service < alt + shift - 2 : yabai --stop-service
service < alt + shift - 3 : yabai --restart-service

# restarting skhd
service < alt + shift - 4 : skhd --start-service
service < alt + shift - 5 : skhd --stop-service
service < alt + shift - 6 : skhd --restart-service

# restarting border
service < alt + shift - 7 : brew services restart borders

# moving windows to different displays
default < alt + ctrl + shift - 1 : yabai -m window --display 1
default < alt + ctrl + shift - 2 : yabai -m window --display 2
default < alt + ctrl + shift - 3 : yabai -m window --display 3
default < alt + ctrl + shift - 4 : yabai -m window --display 4

#balance windows

# move focused window to different areas warp
# default < alt + ctrl + shift - j : yabai -m window --warp north
# default < alt + ctrl + shift - k : yabai -m window --warp south
# default < alt + ctrl + shift - l : yabai -m window --warp east
# default < alt + ctrl + shift - h : yabai -m window --warp west
# # Rotate on X and Y Axis

# Rotatiing windoes on Display
default < shift + alt - t : yabai -m window --toggle float
default < shift + alt - r : yabai -m space --rotate 90

# Moving to space index
default < hyper - 1 : yabai -m space focus 1
default < hyper - 2 : yabai -m space focus 2
default < hyper - 3 : yabai -m space focus 3
default < hyper - 4 : yabai -m space focus 4 
default < hyper - 5 : yabai -m space focus 5 
default < hyper - 6 : yabai -m space focus 6
default < hyper - 7 : yabai -m space focus 7
default < hyper - 8 : yabai -m space focus 8

default < hyper - h : yabai -m window --focus west
default < hyper - j : yabai -m window --focus south
default < hyper - k : yabai -m window --focus north
default < hyper - l : yabai -m window --focus east

# :: resize t : yabai -m config active_window_border_color 0xff775759 
# alt - r; resize
# resize < alt - r ; default
# Creating and Destroying spaces
# alt + shift - f : yabai -m space --create
# alt + shift - g : yabai -m space --destroy



# Resizing Windows
resize < hyper - a : yabai -m window --resize left:-20:0
resize < hyper - d : yabai -m window --resize left:20:0
resize < hyper - c : yabai -m window --resize right:20:-20
resize < hyper - z : yabai -m window --resize right:-20:20

# resize < shift + alt - h : yabai -m window --move rel:-20:0
# resize < shift + alt - j : yabai -m window --move rel:0:20
# resize < shift + alt - k : yabai -m window --move rel:0:-20

## resize windows
resize < hyper - h : yabai -m window --move abs:500:800
resize < hyper - k : yabai -m window WINDOW_ID --ratio abs:0.7
resize < hyper - l : yabai -m window WINDOW_ID --ratio abs:0.5
resize < hyper - h : yabai -m window WINDOW_ID --ratio abs:0.3
resize < meh - q : yabai -m window --resize left:-20:0
resize < meh - e : yabai -m window --resize left:20:0
resize < meh - c : yabai -m window --resize right:20:-20
resize < meh - z : yabai -m window --resize right:-20:20
resize < meh - n : yabai -m window --toggle split
resize < hyper - space : yabai -m window --toggle zoom-fullscreen
resize < meh - space: yabai -m window --toggle split
resize < hyper - b: yabai -m space --balance
resize < hyper - f : yabai -m window --toggle float




# Launch applications

launch < x : open -a /Applications/iTerm.app ; yabai -m space --focus 2
launch < a : open -a /Applications/Arc.app ; yabai -m space --focus 1
launch < b : open -a /Applications/BambuStudio.app ; yabai -m space --focus 3
launch < o : open -a /Applications/Obsidian.app ; yabai -m space --focus 5
launch < s : open -a /Applications/Spotify.app ; yabai -m space --focus 3
launch < p : open -a /Applications/PDFgear.app ; yabai -m space --focus 3
launch < f : open -a ~/Applications/Autodesk Fusion.app ; yabai -m space --focus 4
launch < d : open -a /Applications/Legcord.app ; yabai -m space --focus 6
launch < escape : open -a /System/Applications/System Settings.app ; yabai -m space --focus 1
launch <  backspace : open -a /System/Library/CoreServices/Finder.app ; yabai -m space --focus 1
launch < escape; default
